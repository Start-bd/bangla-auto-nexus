# The project was scaffolded with bun (bun.lockb). npm is stricter about peer
# deps than bun was:
#   - @tanstack/zod-adapter@1.167.0 peers zod@^3.23.8, but this app targets zod@4
#     (no zod-4-compatible adapter release exists yet).
#   - Downgrading zod to v3 would break the zod v4 APIs used in route schemas.
# The adapter's zod usage here is v3/v4-compatible at runtime, so install with
# legacy peer resolution rather than pinning an older zod.
legacy-peer-deps=true
